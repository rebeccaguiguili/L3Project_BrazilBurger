<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brasil Burger</title>
    <script type="importmap"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/aSPBrazilBurger.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Header -->
    <header>
        <a class="logo" asp-controller="Home" asp-action="Index">
            <div class="logo-icon">BB</div>
            <span>BRASIL BURGER</span>
        </a>

        <nav class="d-none d-md-flex">
            <a asp-controller="Home" asp-action="Index">Accueil</a>
            <a asp-controller="Catalog" asp-action="Index">Catalogue</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Order" asp-action="MyOrders">Mes commandes</a>
            }
        </nav>

        <div class="nav-icons">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-white" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle"></i> @User.Identity.Name
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-box-arrow-right"></i> Déconnexion
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-commander">
                    Connexion
                </a>
            }
        </div>

        <!-- Mobile menu toggle (Bootstrap) -->
        <button class="navbar-toggler d-md-none ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#mobileMenu" aria-controls="mobileMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Mobile menu -->
        <div class="collapse navbar-collapse w-100" id="mobileMenu">
            <ul class="navbar-nav w-100 mt-3">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i> Accueil
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Catalog" asp-action="Index">
                        <i class="bi bi-list"></i> Catalogue
                    </a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Order" asp-action="MyOrders">
                            <i class="bi bi-bag-check"></i> Mes commandes
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus"></i> Inscription
                        </a>
                    </li>
                }
            </ul>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-brand">
                <h3>
                    <div class="logo-icon">BB</div>
                    BRASIL BURGER
                </h3>
                <p>
                    Les meilleurs burgers grillés de la ville, préparés avec passion et
                    des ingrédients frais.
                </p>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>
            <div class="footer-column">
                <h4>Navigation</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Accueil</a></li>
                    <li><a asp-controller="Catalog" asp-action="Index"><i class="fas fa-list"></i> Catalogue</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li><a asp-controller="Order" asp-action="MyOrders"><i class="fas fa-shopping-bag"></i> Mes commandes</a></li>
                    }
                </ul>
            </div>
            <div class="footer-column">
                <h4>Contact</h4>
                <ul>
                    <li>
                        <a href="tel:+22177123456"><i class="fas fa-phone"></i> +221 77 123 45 67</a>
                    </li>
                    <li>
                        <p><i class="fas fa-map-marker-alt"></i> Dakar, Sénégal</p>
                    </li>
                </ul>
            </div>
            <div class="footer-column">
                <h4>Horaires</h4>
                <ul>
                    <li>
                        <p><i class="fas fa-clock"></i> Lun - Ven: 11h - 23h</p>
                    </li>
                    <li>
                        <p><i class="fas fa-clock"></i> Sam - Dim: 12h - 00h</p>
                    </li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year Brasil Burger. Tous droits réservés.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
