@{
    ViewData["Title"] = "Accueil";
}

<!-- Hero Section -->
<div class="hero-section text-center text-white py-5 mb-5" style="background: linear-gradient(135deg, #198754 0%, #0d6efd 100%); border-radius: 15px;">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">
            <i class="bi bi-shop"></i> Brasil Burger
        </h1>
        <p class="lead mb-4">Les meilleurs burgers de Dakar, préparés avec passion</p>
        <div class="d-inline-flex gap-3">
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-warning btn-lg">
                <i class="bi bi-list"></i> Voir le catalogue
            </a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg">
                    <i class="bi bi-person-plus"></i> Créer un compte
                </a>
            }
        </div>
    </div>
</div>

<!-- Avantages -->
<div class="row mb-5">
    <div class="col-md-4 text-center mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="mb-3">
                    <i class="bi bi-lightning-charge text-warning" style="font-size: 3rem;"></i>
                </div>
                <h4>Livraison rapide</h4>
                <p class="text-muted">Recevez votre commande en un temps record partout à Dakar</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 text-center mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="mb-3">
                    <i class="bi bi-award text-success" style="font-size: 3rem;"></i>
                </div>
                <h4>Qualité garantie</h4>
                <p class="text-muted">Ingrédients frais et de première qualité pour des burgers exceptionnels</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 text-center mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="mb-3">
                    <i class="bi bi-credit-card text-primary" style="font-size: 3rem;"></i>
                </div>
                <h4>Paiement facile</h4>
                <p class="text-muted">Wave, Orange Money ou espèces - vous choisissez !</p>
            </div>
        </div>
    </div>
</div>

<!-- Comment ça marche -->
<div class="mb-5">
    <h2 class="text-center mb-4">Comment commander ?</h2>
    <div class="row">
        <div class="col-md-3 text-center mb-4">
            <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <h2 class="mb-0">1</h2>
            </div>
            <h5>Parcourez le catalogue</h5>
            <p class="text-muted">Découvrez nos burgers et menus</p>
        </div>

        <div class="col-md-3 text-center mb-4">
            <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <h2 class="mb-0">2</h2>
            </div>
            <h5>Personnalisez</h5>
            <p class="text-muted">Ajoutez des compléments à votre goût</p>
        </div>

        <div class="col-md-3 text-center mb-4">
            <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <h2 class="mb-0">3</h2>
            </div>
            <h5>Payez en ligne</h5>
            <p class="text-muted">Choisissez votre mode de paiement</p>
        </div>

        <div class="col-md-3 text-center mb-4">
            <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <h2 class="mb-0">4</h2>
            </div>
            <h5>Dégustez !</h5>
            <p class="text-muted">Recevez et savourez votre commande</p>
        </div>
    </div>
</div>

<!-- Call to action -->
<div class="text-center bg-light p-5 rounded mb-5">
    <h2 class="mb-3">Prêt à commander ?</h2>
    <p class="lead mb-4">Rejoignez des milliers de clients satisfaits</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-success btn-lg">
            <i class="bi bi-cart-plus"></i> Commander maintenant
        </a>
    }
    else
    {
        <div class="d-inline-flex gap-3">
            <a asp-controller="Account" asp-action="Register" class="btn btn-success btn-lg">
                <i class="bi bi-person-plus"></i> Créer un compte
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success btn-lg">
                <i class="bi bi-box-arrow-in-right"></i> Se connecter
            </a>
        </div>
    }
</div>

<!-- Statistiques -->
<div class="row text-center mb-5">
    <div class="col-md-4 mb-3">
        <h2 class="text-success display-4">500+</h2>
        <p class="text-muted">Clients satisfaits</p>
    </div>
    <div class="col-md-4 mb-3">
        <h2 class="text-success display-4">1000+</h2>
        <p class="text-muted">Commandes livrées</p>
    </div>
    <div class="col-md-4 mb-3">
        <h2 class="text-success display-4">4.8/5</h2>
        <p class="text-muted">Note moyenne</p>
    </div>
</div>
