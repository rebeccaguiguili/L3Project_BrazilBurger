@model aSPBrazilBurger.Models.ViewModels.CatalogViewModel
@{
    ViewData["Title"] = "Catalogue";
}

<div style="padding: 80px 0 0 0;">
    <!-- Header du catalogue -->
    <div class="section-title">
        <h2>NOTRE <span>CATALOGUE</span></h2>
        <p>Découvrez nos délicieux burgers et menus complets</p>
    </div>

    <!-- Filtres -->
    <div class="container mb-5">
        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Index" asp-route-filter="tous"
               class="@(string.IsNullOrEmpty(Model.CurrentFilter) || Model.CurrentFilter == "tous" ? "btn-primary" : "btn-view-all")"
               style="padding: 12px 30px; text-decoration: none;">
                Tous
            </a>
            <a asp-action="Index" asp-route-filter="burgers"
               class="@(Model.CurrentFilter == "burgers" ? "btn-primary" : "btn-view-all")"
               style="padding: 12px 30px; text-decoration: none;">
                Burgers
            </a>
            <a asp-action="Index" asp-route-filter="menus"
               class="@(Model.CurrentFilter == "menus" ? "btn-primary" : "btn-view-all")"
               style="padding: 12px 30px; text-decoration: none;">
                Menus
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mb-4">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Section Burgers -->
    @if (Model.Burgers.Any())
    {
        <section class="burgers-section">
            <div class="section-title">
                <h2>NOS <span>BURGERS</span> SIGNATURES</h2>
                <p>Préparés avec amour et grillés à la perfection</p>
            </div>
            <div class="burgers-grid">
                @foreach (var burger in Model.Burgers)
                {
                    <div class="burger-card">
                        @if (!string.IsNullOrEmpty(burger.Produit.ImageUrl))
                        {
                            <img src="@burger.Produit.ImageUrl" alt="@burger.Produit.Nom" class="burger-image" />
                        }
                        else
                        {
                            <div class="burger-image" style="background: linear-gradient(135deg, #f5f0e8 0%, #e8d5c4 100%); display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-hamburger" style="font-size: 60px; color: var(--primary-red);"></i>
                            </div>
                        }
                        <div class="burger-info">
                            <h3>@burger.Produit.Nom</h3>
                            @if (!string.IsNullOrEmpty(burger.Description))
                            {
                                <p>@burger.Description</p>
                            }
                            else
                            {
                                <p>Un délicieux burger grillé à la perfection</p>
                            }
                            <div class="burger-footer">
                                <span class="price">@burger.Produit.Prix.ToString("N0") FCFA</span>
                                <a asp-controller="Order" asp-action="Create" asp-route-productId="@burger.Produit.Id" class="btn-add">
                                    <i class="fas fa-plus"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <a asp-action="Details" asp-route-id="@Model.Burgers.First().Produit.Id" class="btn-view-all" style="margin-top: 20px;">
                Voir les détails
                <i class="fas fa-arrow-right"></i>
            </a>
        </section>
    }

    <!-- Section Menus -->
    @if (Model.Menus.Any())
    {
        <section class="menus-section">
            <div class="section-title">
                <h2>NOS <span>MENUS</span> COMPLETS</h2>
                <p>Burger + Frites + Boisson : le combo parfait</p>
            </div>
            <div class="menus-grid">
                @foreach (var menu in Model.Menus)
                {
                    <div class="menu-card">
                        <span class="menu-badge">Menu Complet</span>
                        @if (!string.IsNullOrEmpty(menu.Produit.ImageUrl))
                        {
                            <img src="@menu.Produit.ImageUrl" alt="@menu.Produit.Nom" class="menu-image" />
                        }
                        else
                        {
                            <div class="menu-image" style="background: linear-gradient(135deg, #f5f0e8 0%, #e8d5c4 100%); display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-utensils" style="font-size: 60px; color: var(--primary-red);"></i>
                            </div>
                        }
                        <div class="menu-info">
                            <h3>@menu.Produit.Nom</h3>
                            @if (menu.Compositions.Any())
                            {
                                <ul class="menu-items">
                                    @foreach (var comp in menu.Compositions.Take(4))
                                    {
                                        <li><i class="fas fa-circle"></i> @comp.Burger.Produit.Nom</li>
                                    }
                                </ul>
                            }
                            else if (!string.IsNullOrEmpty(menu.Description))
                            {
                                <ul class="menu-items">
                                    <li><i class="fas fa-circle"></i> @menu.Description</li>
                                </ul>
                            }
                            else
                            {
                                <ul class="menu-items">
                                    <li><i class="fas fa-circle"></i> Burger signature</li>
                                    <li><i class="fas fa-circle"></i> Frites croustillantes</li>
                                    <li><i class="fas fa-circle"></i> Boisson au choix</li>
                                </ul>
                            }
                            <div class="menu-footer">
                                <span class="menu-price">@menu.Produit.Prix.ToString("N0") FCFA</span>
                                <a asp-controller="Order" asp-action="Create" asp-route-productId="@menu.Produit.Id" class="btn-add">
                                    <i class="fas fa-plus"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Message si aucun produit -->
    @if (!Model.Burgers.Any() && !Model.Menus.Any())
    {
        <section style="padding: 80px 50px; background-color: var(--white);">
            <div class="alert alert-info text-center" role="alert" style="max-width: 600px; margin: 0 auto;">
                <i class="fas fa-info-circle" style="font-size: 48px; color: var(--warm-yellow); margin-bottom: 15px;"></i>
                <h4 style="color: var(--dark-brown); margin-bottom: 10px;">Aucun produit disponible</h4>
                <p style="color: var(--text-light); margin-bottom: 0;">Nos délicieux burgers arrivent bientôt !</p>
            </div>
        </section>
    }
</div>
