@model aSPBrazilBurger.Models.ViewModels.OrderTrackingViewModel
@{
    ViewData["Title"] = "Commande confirmée";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Animation succès -->
            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 6rem;"></i>
                </div>
                <h1 class="display-4 text-success">Commande confirmée !</h1>
                <p class="lead">Merci pour votre commande</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Informations commande -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-receipt"></i> Détails de votre commande</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Numéro de commande :</strong>
                        </div>
                        <div class="col-6 text-end">
                            <span class="badge bg-primary fs-6">#@Model.CommandeId</span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Date :</strong>
                        </div>
                        <div class="col-6 text-end">
                            @Model.DateCommande.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Type :</strong>
                        </div>
                        <div class="col-6 text-end">
                            @if (Model.TypeConsommation == aSPBrazilBurger.Models.Enums.TypeConsommation.SurPlace)
                            {
                                <span class="badge bg-info"><i class="bi bi-shop"></i> Sur place</span>
                            }
                            else if (Model.TypeConsommation == aSPBrazilBurger.Models.Enums.TypeConsommation.AEmporter)
                            {
                                <span class="badge bg-warning"><i class="bi bi-bag"></i> À emporter</span>
                            }
                            else
                            {
                                <span class="badge bg-dark"><i class="bi bi-truck"></i> Livraison</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Montant payé :</strong>
                        </div>
                        <div class="col-6 text-end">
                            <strong class="text-success fs-5">@Model.MontantTotal.ToString("N0") FCFA</strong>
                        </div>
                    </div>

                    @if (Model.Paiements.Any())
                    {
                        var paiement = Model.Paiements.First();
                        <div class="row">
                            <div class="col-6">
                                <strong>Méthode de paiement :</strong>
                            </div>
                            <div class="col-6 text-end">
                                @paiement.Methode
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Articles commandés -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Articles commandés</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var ligne in Model.Lignes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    <strong>@ligne.NomProduit</strong>
                                    <span class="badge bg-secondary">x@ligne.Quantite</span>
                                </span>
                                <span>@ligne.SousTotal.ToString("N0") FCFA</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <!-- Prochaines étapes -->
            <div class="card mb-4 border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Prochaines étapes</h5>
                </div>
                <div class="card-body">
                    @if (Model.TypeConsommation == aSPBrazilBurger.Models.Enums.TypeConsommation.Livraison)
                    {
                        <p class="mb-2"><i class="bi bi-1-circle-fill text-success"></i> Votre commande est en préparation</p>
                        <p class="mb-2"><i class="bi bi-2-circle text-muted"></i> Un livreur sera assigné</p>
                        <p class="mb-0"><i class="bi bi-3-circle text-muted"></i> Vous recevrez votre commande à l'adresse indiquée</p>
                    }
                    else if (Model.TypeConsommation == aSPBrazilBurger.Models.Enums.TypeConsommation.AEmporter)
                    {
                        <p class="mb-2"><i class="bi bi-1-circle-fill text-success"></i> Votre commande est en préparation</p>
                        <p class="mb-0"><i class="bi bi-2-circle text-muted"></i> Vous pourrez la récupérer au restaurant dès qu'elle sera prête</p>
                    }
                    else
                    {
                        <p class="mb-2"><i class="bi bi-1-circle-fill text-success"></i> Votre commande est en préparation</p>
                        <p class="mb-0"><i class="bi bi-2-circle text-muted"></i> Elle sera servie à votre table</p>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="d-grid gap-2">
                <a asp-action="Details" asp-route-id="@Model.CommandeId" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-eye"></i> Voir les détails de la commande
                </a>
                <a asp-action="MyOrders" class="btn btn-outline-success">
                    <i class="bi bi-list-ul"></i> Toutes mes commandes
                </a>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-success">
                    <i class="bi bi-arrow-left"></i> Retour au catalogue
                </a>
            </div>
        </div>
    </div>
</div>
