@model aSPBrazilBurger.Models.ViewModels.OrderTrackingViewModel
@{
    ViewData["Title"] = "Paiement";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center mb-4">
                <i class="bi bi-credit-card text-success" style="font-size: 4rem;"></i>
                <h2 class="mt-3">Finaliser votre commande</h2>
                <p class="text-muted">Commande #@Model.CommandeId</p>
            </div>

            <!-- Récapitulatif commande -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-list-ul"></i> Récapitulatif de la commande</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <thead>
                            <tr>
                                <th>Produit</th>
                                <th class="text-center">Qté</th>
                                <th class="text-end">Prix</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ligne in Model.Lignes)
                            {
                                <tr>
                                    <td>@ligne.NomProduit</td>
                                    <td class="text-center">@ligne.Quantite</td>
                                    <td class="text-end">@ligne.PrixUnitaire.ToString("N0") FCFA</td>
                                    <td class="text-end">@ligne.SousTotal.ToString("N0") FCFA</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-success">
                                <td colspan="3" class="text-end"><strong>MONTANT TOTAL</strong></td>
                                <td class="text-end"><strong class="fs-4">@Model.MontantTotal.ToString("N0") FCFA</strong></td>
                            </tr>
                        </tfoot>
                    </table>

                    @if (!string.IsNullOrEmpty(Model.AdresseLivraison))
                    {
                        <hr/>
                        <p class="mb-0">
                            <i class="bi bi-truck"></i>
                            <strong>Adresse de livraison :</strong><br/>
                            @Model.AdresseLivraison
                        </p>
                    }
                </div>
            </div>

            <!-- Méthodes de paiement -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-wallet2"></i> Choisissez votre méthode de paiement</h5>
                </div>
                <div class="card-body">
                    <form asp-action="ProcessPayment" method="post">
                        <input type="hidden" name="commandeId" value="@Model.CommandeId" />

                        <div class="row g-3">
                            <!-- Wave -->
                            <div class="col-md-4">
                                <button type="submit" name="methode" value="Wave" class="btn btn-outline-primary w-100 h-100 p-4">
                                    <i class="bi bi-phone" style="font-size: 3rem;"></i>
                                    <h5 class="mt-2">Wave</h5>
                                    <small class="text-muted">Paiement mobile</small>
                                </button>
                            </div>

                            <!-- Orange Money -->
                            <div class="col-md-4">
                                <button type="submit" name="methode" value="Om" class="btn btn-outline-warning w-100 h-100 p-4">
                                    <i class="bi bi-phone-fill" style="font-size: 3rem;"></i>
                                    <h5 class="mt-2">Orange Money</h5>
                                    <small class="text-muted">Paiement mobile</small>
                                </button>
                            </div>

                            <!-- Espèces -->
                            <div class="col-md-4">
                                <button type="submit" name="methode" value="Especes" class="btn btn-outline-success w-100 h-100 p-4">
                                    <i class="bi bi-cash-stack" style="font-size: 3rem;"></i>
                                    <h5 class="mt-2">Espèces</h5>
                                    <small class="text-muted">Paiement en liquide</small>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Info sécurité -->
            <div class="alert alert-info" role="alert">
                <i class="bi bi-shield-check"></i>
                <strong>Paiement sécurisé</strong> - Dans cette version de démonstration, le paiement est simulé. Aucun montant ne sera débité.
            </div>

            <div class="text-center">
                <a asp-action="MyOrders" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Annuler et retourner à mes commandes
                </a>
            </div>
        </div>
    </div>
</div>
