@model aSPBrazilBurger.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">Créer un compte</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Nom" class="form-label"></label>
                            <input asp-for="Nom" class="form-control" placeholder="Votre nom" />
                            <span asp-validation-for="Nom" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Prenom" class="form-label"></label>
                            <input asp-for="Prenom" class="form-control" placeholder="Votre prénom" />
                            <span asp-validation-for="Prenom" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Telephone" class="form-label"></label>
                            <input asp-for="Telephone" class="form-control" placeholder="+221 XX XXX XX XX" />
                            <span asp-validation-for="Telephone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="votre@email.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MotDePasse" class="form-label"></label>
                            <input asp-for="MotDePasse" class="form-control" type="password" placeholder="Au moins 6 caractères" />
                            <span asp-validation-for="MotDePasse" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmerMotDePasse" class="form-label"></label>
                            <input asp-for="ConfirmerMotDePasse" class="form-control" type="password" />
                            <span asp-validation-for="ConfirmerMotDePasse" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Adresse" class="form-label"></label>
                            <textarea asp-for="Adresse" class="form-control" rows="3" placeholder="Votre adresse complète (optionnel)"></textarea>
                            <span asp-validation-for="Adresse" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-person-plus"></i> S'inscrire
                            </button>
                        </div>
                    </form>

                    <hr />

                    <div class="text-center">
                        <p class="mb-0">Vous avez déjà un compte ?
                            <a asp-action="Login" class="text-success fw-bold">Se connecter</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
