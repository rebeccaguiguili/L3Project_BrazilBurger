@model aSPBrazilBurger.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="auth-main">
    <div class="auth-container register">
        <div class="auth-header">
            <div class="auth-icon">
                <i class="fas fa-user"></i>
            </div>
            <h1 class="auth-title">BRASIL BURGER</h1>
        </div>

        <div class="auth-tabs">
            <a asp-action="Login" class="auth-tab">Connexion</a>
            <span class="auth-tab active">Inscription</span>
        </div>

        <form asp-action="Register" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Prenom">Prénom</label>
                    <div class="input-wrapper no-icon">
                        <input asp-for="Prenom" placeholder="Jean" />
                    </div>
                    <span asp-validation-for="Prenom" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Nom">Nom</label>
                    <div class="input-wrapper no-icon">
                        <input asp-for="Nom" placeholder="Dupont" />
                    </div>
                    <span asp-validation-for="Nom" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <div class="input-wrapper">
                    <i class="fas fa-envelope"></i>
                    <input asp-for="Email" type="email" placeholder="votre@email.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Telephone">Téléphone</label>
                <div class="input-wrapper">
                    <i class="fas fa-phone"></i>
                    <input asp-for="Telephone" placeholder="77 123 45 67" />
                </div>
                <span asp-validation-for="Telephone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MotDePasse">Mot de passe</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock"></i>
                    <input asp-for="MotDePasse" type="password" placeholder="••••••••" />
                </div>
                <span asp-validation-for="MotDePasse" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmerMotDePasse">Confirmer le mot de passe</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock"></i>
                    <input asp-for="ConfirmerMotDePasse" type="password" placeholder="••••••••" />
                </div>
                <span asp-validation-for="ConfirmerMotDePasse" class="text-danger"></span>
            </div>

            <!-- Champ adresse masqué mais présent pour la validation -->
            <div class="form-group" style="display: none;">
                <input asp-for="Adresse" type="hidden" value="" />
            </div>

            <button type="submit" class="btn-submit">CRÉER UN COMPTE</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
