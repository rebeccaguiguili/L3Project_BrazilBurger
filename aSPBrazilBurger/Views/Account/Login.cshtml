@model aSPBrazilBurger.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Connexion";
}

<div class="auth-main">
    <div class="auth-container">
        <div class="auth-header">
            <div class="auth-icon">
                <i class="fas fa-user"></i>
            </div>
            <h1 class="auth-title">BRASIL BURGER</h1>
        </div>

        <div class="auth-tabs">
            <span class="auth-tab active">Connexion</span>
            <a asp-action="Register" class="auth-tab">Inscription</a>
        </div>

        <form asp-action="Login" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <div class="input-wrapper">
                    <i class="fas fa-envelope"></i>
                    <input asp-for="Email" type="email" placeholder="votre@email.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MotDePasse">Mot de passe</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock"></i>
                    <input asp-for="MotDePasse" type="password" placeholder="••••••••" />
                </div>
                <span asp-validation-for="MotDePasse" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-submit">SE CONNECTER</button>
        </form>

        <div class="test-accounts">
            <h4>Comptes de test :</h4>
            <p>Client: client@test.com / client123</p>
            <p>Gestionnaire: gestionnaire@brasilburger.com / admin123</p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
